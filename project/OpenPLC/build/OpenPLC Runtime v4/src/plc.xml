              <type>
                <REAL/>
              </type>
            </variable>
            <variable name="WaterPresent">
              <type>
                <BOOL/>
              </type>
            </variable>
            <variable name="DryDelayTimer">
              <type>
                <derived name="TON"/>
              </type>
            </variable>
            <variable name="PumpTimer">
              <type>
                <derived name="TON"/>
              </type>
            </variable>
            <variable name="AbsorbTimer">
              <type>
                <derived name="TON"/>
              </type>
            </variable>
            <variable name="State">
              <type>
                <INT/>
              </type>
              <initialValue>
                <simpleValue value="0"/>
              </initialValue>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml:p><![CDATA[IF TemperatureOK = 1 THEN
    TemperatureC := INT_TO_REAL(TemperatureRaw) / 100.0;
ELSE
    TemperatureC := 0.0;
END_IF;

BatteryVoltageV :=
    UINT_TO_REAL(BatteryVoltageMv) / 1000.0;

ShuntVoltageMv :=
    UINT_TO_REAL(ShuntVoltageUv) / 1000.0;

WaterPresent := HallActive;

CASE State OF

0:
    MotorCommand := FALSE;

    DryDelayTimer(
        IN := WaterPresent AND (MoistureRaw > 3000),
        PT := T#6s
    );

    IF DryDelayTimer.Q THEN
        State := 1;
    END_IF;

1:
    MotorCommand := WaterPresent;

    PumpTimer(
        IN := TRUE,
        PT := T#3s
    );

    IF PumpTimer.Q OR NOT WaterPresent THEN
        MotorCommand := FALSE;
        State := 2;
    END_IF;

2:
    MotorCommand := FALSE;

    AbsorbTimer(
        IN := TRUE,
        PT := T#5m
    );

    IF AbsorbTimer.Q THEN
        IF WaterPresent AND (MoistureRaw > 2300) THEN
            State := 1;
        ELSE
            State := 0;
        END_IF;
    END_IF;

ELSE
    MotorCommand := FALSE;
    State := 0;

END_CASE;]]></xhtml:p>
          </ST>
        </body>
